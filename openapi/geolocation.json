          },
          "uniqueid": {
            "type": "string",
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "nullable": true,
            "maxLength": 8
          },
          "disabled": {
            "type": "boolean"
          },
          "lastupdate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "position": {
            "type": "string",
            "readOnly": true
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "maxLength": 128
          },
          "model": {
            "type": "string",
            "nullable": true,
            "maxLength": 128
          },

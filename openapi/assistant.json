  "components": {
    "schemas": {
      "AnswerFeedbackInput": {
        "type": "object",
        "properties": {
          "rating": {
            "$ref": "#/components/schemas/RatingEnum"
          },
          "comment": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "rating"
        ]
      },
      "ChannelEnum": {
        "enum": [
          "whatsapp",
          "instagram",
          "telegram"
        ],
        "type": "string",
        "description": "* `whatsapp` - WhatsApp\n* `instagram` - Instagram\n* `telegram` - Telegram"
      },
      "ChannelSession": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "title": {
            "type": "string",
            "readOnly": true
          },
          "channel": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ChannelEnum"
              }
            ],
            "readOnly": true,
            "description": "Empty for staff conversations held in the Yume UI.\n\n* `whatsapp` - WhatsApp\n* `instagram` - Instagram\n* `telegram` - Telegram"
          },
          "external_chat_id": {
            "type": "string",
            "readOnly": true,
            "description": "Counterparty address on that channel (phone, instagram id, ...)."
          },
          "handoff": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HandoffEnum"
              }
            ],
            "readOnly": true
          },
          "handoff_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "nullable": true
          },
          "last_delivery_error": {
            "type": "string",
            "readOnly": true
          },
          "last_delivery_error_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "title": "Создан"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "title": "Обновлен"
          }
        },
        "required": [
          "channel",
          "created_at",
          "external_chat_id",
          "handoff",
          "handoff_at",
          "id",
          "last_delivery_error",
          "last_delivery_error_at",
          "title",
          "updated_at"
        ]
      },
      "ChatStreamInput": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "provider": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProviderEnum"
              }
            ],
            "default": "anthropic"
          },
          "tier": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TierEnum"
              }
            ],
            "default": "low"
          },
          "model": {
            "type": "string"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "thinking_effort": {
            "$ref": "#/components/schemas/ThinkingEffortEnum"
          },
          "page_context": {
            "type": "string"
          },
          "preset": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "HandoffEnum": {
        "enum": [
          "agent",
          "human"
        ],
        "type": "string",
        "description": "* `agent` - Агент\n* `human` - Человек"
      },
      "HandoffInput": {
        "type": "object",
        "properties": {
          "handoff": {
            "$ref": "#/components/schemas/HandoffEnum"
          }
        },
        "required": [
          "handoff"
        ]
      },
      "KindEnum": {
        "enum": [
          "system-prompt",
          "user-prompt",
          "tool-return",
          "retry-prompt",
          "text",
          "thinking",
          "compaction",
          "tool-call",
          "builtin-tool-call",
          "builtin-tool-return",
          "file"
        ],
        "type": "string",
        "description": "* `system-prompt` - Системный промпт\n* `user-prompt` - Запрос пользователя\n* `tool-return` - Ответ инструмента\n* `retry-prompt` - Повторный запрос\n* `text` - Текст\n* `thinking` - Размышления\n* `compaction` - Сжатие контекста\n* `tool-call` - Вызов инструмента\n* `builtin-tool-call` - Вызов встроенного инструмента\n* `builtin-tool-return` - Ответ встроенного инструмента\n* `file` - Файл"
      },
      "PaginatedChannelSessionList": {
        "type": "object",
        "required": [
          "count",
          "results"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "example": 123
          },
          "next": {
            "type": "string",
            "nullable": true,
            "format": "uri",
            "example": "http://api.example.org/accounts/?page=4"
          },
          "previous": {
            "type": "string",
            "nullable": true,
            "format": "uri",
            "example": "http://api.example.org/accounts/?page=2"
          },
          "results": {

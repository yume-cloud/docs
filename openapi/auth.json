            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CrossTokenLogin"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Create cross login",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          }

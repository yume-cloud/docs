          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true
          },
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "tags": [
          "conversations"
        ],
        "security": [
          {
            "jwtAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "No response body"
          }
        },
        "summary": "Delete conversations"
      }
    },
    "/v1/chat/conversations/{id}/handoff/": {
      "post": {
        "operationId": "conversations_handoff_create",
        "description": "Поддержка забирает диалог себе или возвращает ассистенту; у пользователя такой кнопки нет.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true

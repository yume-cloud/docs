    },
    "/v1/chat/conversations/{id}/members/{user_id}/": {
      "delete": {
        "operationId": "conversations_members_destroy",
        "description": "Leaving is always allowed; removing someone else needs the creator or an admin.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true
          },
          {
            "in": "path",
            "name": "user_id",
            "schema": {
              "type": "integer"
            },
            "required": true
          },
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "tags": [
          "conversations"
        ],
        "security": [
          {
            "jwtAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "No response body"
          }
        },
        "summary": "Delete members"
      }

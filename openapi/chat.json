{
  "openapi": "3.0.3",
  "info": {
    "title": "Yume API — Сообщения",
    "version": "1.0.0",
    "description": "Переписка сотрудников и чат с поддержкой Yume."
  },
  "paths": {
    "/v1/chat/conversations/": {
      "get": {
        "operationId": "conversations_retrieve",
        "tags": [
          "conversations"
        ],
        "security": [
          {
            "jwtAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "No response body"
          }
        },
        "summary": "Get conversations",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ]
      },
      "post": {
        "operationId": "conversations_create",
        "tags": [
          "conversations"
        ],
        "security": [
          {
            "jwtAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "No response body"
          }
        },
        "summary": "Create conversations",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ]
      }
    },
    "/v1/chat/conversations/{id}/": {
      "patch": {
        "operationId": "conversations_partial_update",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true
          },
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "tags": [
          "conversations"
        ],
        "security": [
          {
            "jwtAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "No response body"

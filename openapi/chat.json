      "post": {
        "operationId": "conversations_members_create",
        "description": "Any member may add people, like in Telegram; the adder must already be in the group.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true

      "TypeEnum": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "description": "* `0` - Обычное сообщение\n* `1` - Документ\n* `2` - Одноразовый код"
      }
    },
    "securitySchemes": {
      "jwtAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "TenantId": {
        "name": "X-Tenant-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "integer"
        },
        "description": "Компания, в контексте которой выполняется запрос — её id из `GET /v1/tenant/`. Пользователь должен состоять в этой компании: чужой id доступа к данным не даёт. Без заголовка компания определяется по домену запроса."
      }
    }

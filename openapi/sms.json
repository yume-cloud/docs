              {
                "$ref": "#/components/schemas/BlankEnum"
              },
              {
                "$ref": "#/components/schemas/NullEnum"
              }
            ]
          },
          "client": {
            "type": "string",
            "readOnly": true
          },
          "request_id": {
            "type": "string",
            "readOnly": true
          }
        },
        "required": [

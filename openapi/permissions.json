  "components": {
    "schemas": {
      "ContentTypePermission": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "app_label": {
            "type": "string",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "readOnly": true
          },
          "type": {
            "type": "string",
            "readOnly": true
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          },
          "model": {
            "type": "string",
            "title": "Имя класса модели",
            "maxLength": 100
          }
        },
        "required": [
          "app_label",
          "id",
          "model",
          "name",
          "permissions",
          "type"
        ]
      },
      "Group": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "name": {
